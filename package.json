{
  "name": "@openscreeps/server",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, embeddable Screeps-compatible standalone server",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/generated/api/index.d.ts",
      "import": "./dist/generated/api/index.js"
    },
    "./openapi.json": "./api/openapi.json",
    "./openapi.yaml": "./api/openapi.yaml"
  },
  "bin": {
    "openscreeps-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "api/openapi.json",
    "api/openapi.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "reference-versions.json"
  ],
  "scripts": {
    "start": "tsx src/cli.ts start",
    "cli": "tsx src/cli.ts",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run check:api && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "@openscreeps/game": "github:openscreeps/game#34041136d36fcf6327a3b1fcbf7f554b5d78234b",
    "@openscreeps/openapi": "github:openscreeps/openapi#b60daa38d83a9c2fd6fdc27d3c250494ba8158b3",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "ini": "7.0.0",
    "lodash": "3.10.1",
    "lokijs": "1.5.6",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "q": "1.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sockjs": "0.3.24",
    "typeorm": "1.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "isolated-vm@7.0.1": true,
    "github:openscreeps/game#34041136d36fcf6327a3b1fcbf7f554b5d78234b": true,
    "github:openscreeps/engine#5187cc94cda1b5a992ec6fe77f7f35cce1bef8db": true,
    "github:openscreeps/openapi#b60daa38d83a9c2fd6fdc27d3c250494ba8158b3": true
  },
  "overrides": {
    "typeorm": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/ini": "4.1.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/sockjs": "0.3.36",
    "@types/sockjs-client": "1.5.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "sockjs-client": "1.6.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
